@page
@model AboutModel
@{
    ViewData["Title"] = "About Us";
}

<section class="about-section py-5">
    <div class="container">
        <h2 class="section-title mb-4">About Crochet Craft</h2>
        <p class="lead text-muted mb-4">
            Crochet Craft is your friendly online destination for everything crochet. We provide premium yarns, tools, patterns, and expert tutorials to help you create beautiful things with your hands.
        </p>
        <p class="text-muted">
            Our mission is to inspire creativity and community by sharing the joy and tradition of crochet. Whether you are a beginner or an expert, our resources are designed to support and encourage your crafting journey.
        </p>
        <p class="text-muted">
            Founded by passionate crochet enthusiasts, we strive to bring warmth, quality, and elegance to your crafting projects.
        </p>
    </div>
</section>