@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<section class="hero">
    <div class="hero-content">
        <div class="container">
            <div class="row align-items-center min-vh-75">
                <div class="col-lg-6">
                    <div class="hero-text">
                        <h1 class="hero-title display-3 fw-bold mb-4">
                            Create Beautiful Things with Your Hands
                        </h1>
                        <p class="hero-description lead mb-4">
                            Discover the art of crochet with our premium supplies, patterns,
                            and comprehensive learning resources. Start your crafting journey today.
                        </p>
                        <div class="hero-actions">
                            <a href="/Shop" class="btn btn-primary btn-lg me-3">
                                <i class="fas fa-shopping-cart me-2"></i>Shop Now
                            </a>
                            <a href="/Learn" class="btn btn-outline-primary btn-lg">
                                <i class="fas fa-graduation-cap me-2"></i>Learn Crochet
                            </a>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="hero-image">
                        <div class="hero-image-placeholder">
                            <i class="fas fa-yarn fa-8x text-primary opacity-50"></i>
                            <p class="mt-3 text-muted">Beautiful crochet lifestyle image</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="hero-background"></div>
</section>

<!-- Shop Preview Section -->
<section class="shop-preview py-5" id="shop">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="section-title display-5 fw-bold mb-3">Shop Crochet Supplies</h2>
            <p class="section-description lead text-muted">
                Premium yarns, hooks, and patterns for all your crochet projects
            </p>
        </div>

        <div class="row g-4">
            <div class="col-lg-3 col-md-6">
                <div class="product-card card h-100 border-0 shadow-sm">
                    <div class="product-image">
                        <div class="product-placeholder">
                            <i class="fas fa-ball-pile fa-3x text-primary"></i>
                        </div>
                    </div>
                    <div class="card-body text-center">
                        <h5 class="card-title">Premium Cotton Yarn</h5>
                        <p class="card-text text-muted">Soft, durable cotton perfect for any project</p>
                        <div class="price fw-bold text-primary fs-5 mb-3">$12.99</div>
                        <button class="btn btn-outline-primary btn-sm">Add to Cart</button>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="product-card card h-100 border-0 shadow-sm">
                    <div class="product-image">
                        <div class="product-placeholder">
                            <i class="fas fa-tools fa-3x text-primary"></i>
                        </div>
                    </div>
                    <div class="card-body text-center">
                        <h5 class="card-title">Ergonomic Hook Set</h5>
                        <p class="card-text text-muted">Complete set with comfortable grips</p>
                        <div class="price fw-bold text-primary fs-5 mb-3">$24.99</div>
                        <button class="btn btn-outline-primary btn-sm">Add to Cart</button>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="product-card card h-100 border-0 shadow-sm">
                    <div class="product-image">
                        <div class="product-placeholder">
                            <i class="fas fa-file-alt fa-3x text-primary"></i>
                        </div>
                    </div>
                    <div class="card-body text-center">
                        <h5 class="card-title">Beginner Patterns</h5>
                        <p class="card-text text-muted">10 easy patterns to get you started</p>
                        <div class="price fw-bold text-primary fs-5 mb-3">$19.99</div>
                        <button class="btn btn-outline-primary btn-sm">Add to Cart</button>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="product-card card h-100 border-0 shadow-sm">
                    <div class="product-image">
                        <div class="product-placeholder">
                            <i class="fas fa-star fa-3x text-primary"></i>
                        </div>
                    </div>
                    <div class="card-body text-center">
                        <h5 class="card-title">Advanced Lace Patterns</h5>
                        <p class="card-text text-muted">Beautiful intricate designs for experts</p>
                        <div class="price fw-bold text-primary fs-5 mb-3">$29.99</div>
                        <button class="btn btn-outline-primary btn-sm">Add to Cart</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="text-center mt-5">
            <a href="/Shop" class="btn btn-primary btn-lg">
                View All Products <i class="fas fa-arrow-right ms-2"></i>
            </a>
        </div>
    </div>
</section>

<!-- Learn Crochet Preview Section -->
<section class="learn-preview py-5 bg-light" id="learn">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="section-title display-5 fw-bold mb-3">Learn Crochet</h2>
            <p class="section-description lead text-muted">
                Master the art of crochet with our step-by-step tutorials and guides
            </p>
        </div>

        <div class="row g-4">
            <div class="col-lg-3 col-md-6">
                <div class="tutorial-card card h-100 border-0 shadow-sm">
                    <div class="tutorial-image">
                        <div class="tutorial-placeholder">
                            <i class="fas fa-play-circle fa-3x text-primary"></i>
                        </div>
                        <div class="tutorial-duration">30 min</div>
                    </div>
                    <div class="card-body">
                        <h5 class="card-title">Basic Stitches</h5>
                        <p class="card-text text-muted">Learn single crochet, double crochet, and more</p>
                        <a href="#" class="btn btn-outline-primary btn-sm">Start Tutorial</a>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="tutorial-card card h-100 border-0 shadow-sm">
                    <div class="tutorial-image">
                        <div class="tutorial-placeholder">
                            <i class="fas fa-book-open fa-3x text-primary"></i>
                        </div>
                        <div class="tutorial-duration">45 min</div>
                    </div>
                    <div class="card-body">
                        <h5 class="card-title">Reading Patterns</h5>
                        <p class="card-text text-muted">Understand crochet patterns and abbreviations</p>
                        <a href="#" class="btn btn-outline-primary btn-sm">Start Tutorial</a>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="tutorial-card card h-100 border-0 shadow-sm">
                    <div class="tutorial-image">
                        <div class="tutorial-placeholder">
                            <i class="fas fa-palette fa-3x text-primary"></i>
                        </div>
                        <div class="tutorial-duration">60 min</div>
                    </div>
                    <div class="card-body">
                        <h5 class="card-title">Colorwork Techniques</h5>
                        <p class="card-text text-muted">Create beautiful multi-colored projects</p>
                        <a href="#" class="btn btn-outline-primary btn-sm">Start Tutorial</a>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="tutorial-card card h-100 border-0 shadow-sm">
                    <div class="tutorial-image">
                        <div class="tutorial-placeholder">
                            <i class="fas fa-award fa-3x text-primary"></i>
                        </div>
                        <div class="tutorial-duration">90 min</div>
                    </div>
                    <div class="card-body">
                        <h5 class="card-title">Advanced Techniques</h5>
                        <p class="card-text text-muted">Master complex stitches and patterns</p>
                        <a href="#" class="btn btn-outline-primary btn-sm">Start Tutorial</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="text-center mt-5">
            <a href="/Learn" class="btn btn-primary btn-lg">
                View All Tutorials <i class="fas fa-arrow-right ms-2"></i>
            </a>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        // Add smooth scrolling for anchor links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                document.querySelector(this.getAttribute('href')).scrollIntoView({
                    behavior: 'smooth'
                });
            });
        });

        // Add hover effects for cards
        document.querySelectorAll('.product-card, .tutorial-card').forEach(card => {
            card.addEventListener('mouseenter', function() {
                this.style.transform = 'translateY(-5px)';
                this.style.transition = 'transform 0.3s ease';
            });

            card.addEventListener('mouseleave', function() {
                this.style.transform = 'translateY(0)';
            });
        });
    </script>
}
