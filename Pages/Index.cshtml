@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<section class="hero-section py-5 bg-light">
    <div class="container">
        <div class="row align-items-center min-vh-75">
            <div class="col-lg-6">
                <div class="hero-content">
                    <h1 class="hero-title">Handmade with <span class="cursive-text">Love</span></h1>
                    <p class="hero-description">
                        Handmade crochet, unique patterns, and quality supplies crafted with love, made for you.
                        Take a look around, explore, and let’s keep the art of crochet thriving one stitch at a time.
                    </p>
                    @if (User.Identity?.IsAuthenticated != true)
                    {
                        <div class="hero-buttons">
                            <a asp-page="/Auth/Register" class="btn btn-primary btn-lg me-3 shadow-sm">Get Started</a>
                            <a asp-page="/Auth/Login" class="btn btn-outline-primary btn-lg shadow-sm">Sign In</a>
                        </div>
                    }
                    else
                    {
                        <div class="hero-buttons">
                            <a asp-page="/About" class="btn btn-primary btn-lg me-3 shadow-sm">Learn More</a>
                            <a asp-page="/Contact" class="btn btn-outline-primary btn-lg shadow-sm">Get In Touch</a>
                        </div>
                    }
                </div>
            </div>
            <div class="col-lg-6">
                <div id="heroCarousel" class="carousel slide hero-image rounded-3 shadow-lg" data-bs-ride="carousel">
                    <div class="carousel-inner">
                        <div class="carousel-item active">
                            <img src="~/images/hero1.jpg" class="d-block w-100 rounded-3" alt="Crochet image 1" />
                        </div>
                        <div class="carousel-item">
                            <img src="~/images/hero2.jpg" class="d-block w-100 rounded-3" alt="Crochet image 2" />
                        </div>
                        <div class="carousel-item">
                            <img src="~/images/hero3.jpg" class="d-block w-100 rounded-3" alt="Crochet image 3" />
                        </div>
                    </div>
                    <div id="heroCarousel" class="carousel slide hero-image rounded-3 shadow-lg" data-bs-ride="carousel" data-bs-interval="4000">
                    <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Updated Shop Section -->
<section class="shop-preview py-5" id="shop">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="section-title display-5 fw-bold mb-3">View Our Shop</h2>
            <p class="section-description lead text-muted">
                Premium yarns, hooks, and patterns for all your crochet projects
            </p>
        </div>

        <div class="row g-4 justify-content-center">
            <div class="col-lg-4 col-md-6">
                <div class="product-card card h-100 border-0 shadow-sm text-center p-3">
                    <img src="~/images/shop/shop-items.jpg" alt="Shop Crochet Items" class="img-fluid rounded mb-3" />
                    <h5 class="card-title">Shop Crochet Items</h5>
                    <a href="/Shop" class="btn btn-primary btn-sm">View</a>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="product-card card h-100 border-0 shadow-sm text-center p-3">
                    <img src="~/images/shop/shop-supplies.jpg" alt="Shop Crochet Supplies" class="img-fluid rounded mb-3" />
                    <h5 class="card-title">Shop Crochet Supplies</h5>
                    <a href="/Shop" class="btn btn-primary btn-sm">View</a>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="product-card card h-100 border-0 shadow-sm text-center p-3">
                    <img src="~/images/shop/shop-tutorials.jpg" alt="Shop Tutorials" class="img-fluid rounded mb-3" />
                    <h5 class="card-title">Shop Tutorials</h5>
                    <a href="/LearnCrochet" class="btn btn-primary btn-sm">View</a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Learn Crochet Preview Section -->
<section class="learn-preview py-5 bg-light" id="learn">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="section-title display-5 fw-bold mb-3">Learn Crochet</h2>
            <p class="section-description lead text-muted">
                Master the art of crochet with our step-by-step tutorials and guides
            </p>
        </div>

        <div class="row g-4 justify-content-center">
            <div class="col-lg-4 col-md-6">
                <div class="tutorial-card card h-100 border-0 shadow-sm">
                    <div class="tutorial-image">
                        <div class="tutorial-placeholder">
                            <i class="fas fa-play-circle fa-3x text-primary"></i>
                        </div>
                        <div class="tutorial-duration">30 min</div>
                    </div>
                    <div class="card-body text-center">
                        <h5 class="card-title">Basic Stitches</h5>
                        <p class="card-text text-muted">Learn single crochet, double crochet, and more</p>
                        <a href="/LearnCrochet" class="btn btn-outline-primary btn-sm">Start Tutorial</a>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="tutorial-card card h-100 border-0 shadow-sm">
                    <div class="tutorial-image">
                        <div class="tutorial-placeholder">
                            <i class="fas fa-book-open fa-3x text-primary"></i>
                        </div>
                        <div class="tutorial-duration">45 min</div>
                    </div>
                    <div class="card-body text-center">
                        <h5 class="card-title">Intermediate Tutorial</h5>
                        <p class="card-text text-muted">Understand crochet patterns and improve your skills</p>
                        <a href="/LearnCrochet" class="btn btn-outline-primary btn-sm">Start Tutorial</a>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="tutorial-card card h-100 border-0 shadow-sm">
                    <div class="tutorial-image">
                        <div class="tutorial-placeholder">
                            <i class="fas fa-award fa-3x text-primary"></i>
                        </div>
                        <div class="tutorial-duration">90 min</div>
                    </div>
                    <div class="card-body text-center">
                        <h5 class="card-title">Advanced Techniques</h5>
                        <p class="card-text text-muted">Master complex stitches and patterns</p>
                        <a href="/LearnCrochet" class="btn btn-outline-primary btn-sm">Start Tutorial</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="text-center mt-5">
            <a href="/LearnCrochet" class="btn btn-primary btn-lg">
                View All Tutorials <i class="fas fa-arrow-right ms-2"></i>
            </a>
        </div>
    </div>
</section>

@section Styles {
    <style>
        .cursive-text {
            font-family: 'Brush Script MT', cursive;
            font-style: italic;
            color: var(--primary-color);
        }
    </style>
}