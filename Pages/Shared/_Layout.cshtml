<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Crochet Craft</title>
    <meta name="description" content="Discover the art of crochet with our premium supplies, patterns, and comprehensive learning resources at Crochet Craft." />

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Font Awesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    @RenderSection("Styles", required: false)
</head>
<body>
    <header class="header sticky-top">
        <nav class="navbar navbar-expand-lg bg-white shadow-sm">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" asp-page="/Index">
                    <i class="fas fa-skein fa-lg me-2 text-secondary"></i>
                    <span class="fw-bold" style="color:#B8AB90;">Crochet Craft</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav mx-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Shop">Shop</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Learn">Learn Crochet</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/About">About</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Contact">Contact</a>
                        </li>
                    </ul>
                    <div class="navbar-nav">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <a class="nav-link" href="/Account/Manage">
                                Hello @User.Identity.Name!
                            </a>
                            <form method="post" asp-area="Identity" asp-page="/Account/Logout" class="d-inline">
                                <button type="submit" class="btn btn-outline-primary btn-sm ms-2">
                                    Sign Out
                                </button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-outline-primary btn-sm me-2" asp-page="/SignIn">
                                Sign In
                            </a>
                            <a class="btn btn-primary btn-sm" asp-page="/Register">
                                Sign Up
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="container my-5">
        @RenderBody()
    </main>

    <footer class="footer bg-light py-5 mt-auto">
        <div class="container">
            <div class="row">
                <!-- Branding & Description -->
                <div class="col-lg-4 mb-4">
                    <h5 class="fw-bold mb-3">Crochet Craft</h5>
                    <p class="text-muted">Create beautiful things with your hands. Discover the art of crochet with premium supplies and expert guidance.</p>
                    <div class="social-links">
                        <a href="#" class="text-decoration-none me-3" aria-label="Facebook">
                            <i class="fab fa-facebook-f"></i>
                        </a>
                        <a href="https://www.instagram.com/_love.knots_/" class="text-decoration-none me-3" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
                            <i class="fab fa-instagram"></i>
                        </a>
                        <a href="#" class="text-decoration-none me-3" aria-label="Pinterest">
                            <i class="fab fa-pinterest"></i>
                        </a>
                        <a href="#" class="text-decoration-none" aria-label="YouTube">
                            <i class="fab fa-youtube"></i>
                        </a>
                    </div>
                </div>

                <!-- Quick Links -->
                <div class="col-lg-2 col-md-4 mb-4">
                    <h6 class="fw-bold mb-3">Quick Links</h6>
                    <ul class="list-unstyled">
                        <li><a asp-page="/Shop" class="text-muted text-decoration-none">Shop</a></li>
                        <li><a asp-page="/Learn" class="text-muted text-decoration-none">Learn</a></li>
                        <li><a asp-page="/About" class="text-muted text-decoration-none">About</a></li>
                        <li><a asp-page="/Contact" class="text-muted text-decoration-none">Contact</a></li>
                    </ul>
                </div>

                <!-- Support -->
                <div class="col-lg-2 col-md-4 mb-4">
                    <h6 class="fw-bold mb-3">Support</h6>
                    <ul class="list-unstyled">
                        <li><a href="#" class="text-muted text-decoration-none">Help Center</a></li>
                        <li><a href="#" class="text-muted text-decoration-none">Privacy Policy</a></li>
                        <li><a href="#" class="text-muted text-decoration-none">Terms of Service</a></li>
                    </ul>
                </div>

                <!-- Newsletter -->
                <div class="col-lg-4 col-md-4 mb-4">
                    <h6 class="fw-bold mb-3">Newsletter</h6>
                    <p class="text-muted small">Get the latest patterns, tips, and special offers.</p>
                    <form class="newsletter-form d-flex" method="post" action="#">
                        <input type="email" class="form-control rounded-start" placeholder="Enter your email" aria-label="Email" required />
                        <button class="btn btn-primary rounded-end" type="submit">Subscribe</button>
                    </form>
                </div>
            </div>
            <hr class="my-4" />
            <div class="row align-items-center">
                <div class="col-md-6">
                    <p class="text-muted small mb-0">&copy; 2025 Crochet Craft. All rights reserved.</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <p class="text-muted small mb-0">
                        <i class="fas fa-envelope me-2"></i>rumaysaafsan17@gmail.com
                        <span class="mx-2">|</span>
                        <i class="fas fa-phone me-2"></i>+91 99008****7
                    </p>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Custom JS -->
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>